PUSH17 1
ADD
SWAP2
SWAP1
SIGNEXTEND
SWAP1

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

// GAP
PUSH31 0
PUSH31 0
PUSH31 0
PUSH31 0

// LT 0x10
JUMPDEST                                    
PUSH18 1                                    // Stack: [1, j, a, b]
ADD                                         // Stack: [i, a, b] i == j + 1
SWAP2                                       // Stack: [b, a, i] 
GT                                          // Stack: [b > a ? 1 : 0, i]
SWAP1                                       // Stack: [i, b > a ? 1 : 0]

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

// GT 0x11
JUMPDEST                                    
PUSH18 1                                    // Stack: [1, j, a, b]
ADD                                         // Stack: [i, a, b] i == j + 1
SWAP2                                       // Stack: [b, a, i] 
LT                                          // Stack: [b < a ? 1 : 0, i]
SWAP1                                       // Stack: [i, b < a ? 1 : 0]

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

// SLT 0x12
JUMPDEST
PUSH18 1                                    // Stack: [1, j, a, b]
ADD
SWAP2
SGT                                         // Stack: [b > a ? 1 : 0, i]
SWAP1

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

// SGT 0x13
JUMPDEST                                    
PUSH18 1                                    // Stack: [1, j, a, b]
ADD
SWAP2
SLT                                         // Stack: [b < a ? 1 : 0, i]
SWAP1

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

// EQ 0x14
JUMPDEST
PUSH18 1                                    // Stack: [1, j, b, a]
ADD                                         // Stack: [i, b, a] i == j + 1
SWAP2                                       // Stack: [a, b, i]
EQ                                          // Stack: [a == b ? 1 : 0, i]
SWAP1

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

// ISZERO 0x15
JUMPDEST
PUSH18 1                                    // Stack: [1, j, a]
ADD                                         // Stack: [i, a] i == j + 1
SWAP1                                       // Stack: [a, i]
ISZERO                                      // Stack: [a == 0 ? 1 : 0, i]
SWAP1

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

