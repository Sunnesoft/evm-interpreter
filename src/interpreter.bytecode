BYTE                                        // [calldata[i+1:i+2], calldata[i:i+0x20], i]
SWAP2                                       // [i, calldata[i:i+0x20], calldata[i+1:i+2]]
PUSH1 2                                     // [2, i, calldata[i:i+0x20], calldata[i+1:i+2]]
ADD                                         // [2 + i, calldata[i:i+0x20], calldata[i+1:i+2]]
SWAP1                                       // [calldata[i:i+0x20], 2 + i, calldata[i+1:i+2]]
PUSH1 2                                     // [2, calldata[i+2:i+3], 2 + i, calldata[i+1:i+2]]
BYTE                                        // [calldata[i+2:i+3], 2 + i, calldata[i+1:i+2]]
PUSH1 5                                     // [5, calldata[i+2:i+3], 2 + i, calldata[i+1:i+2]]
SHL                                         // [calldata[i+2:i+3] << 5, 2 + i, calldata[i+1:i+2]]
JUMP

