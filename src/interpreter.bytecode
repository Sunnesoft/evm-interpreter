// BYTE 0x1A
JUMPDEST
PUSH17 1                                    // Stack: [1, j, i, x]
ADD                                         // Stack: [k, i, x] k = 1 +j
SWAP2                                       // Stack: [x, i, k]
SWAP1                                       // Stack: [i, x, k]
BYTE                                        // Stack: [x[i:i+0x1], k]
SWAP1                                       // Stack: [k, x[i:i+0x1]]

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

