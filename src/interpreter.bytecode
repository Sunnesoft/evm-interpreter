// <Unknown> 0x1E
JUMPDEST
INVALID
STOP
PUSH28 0

// <Unknown> 0x1F
JUMPDEST
INVALID
STOP
PUSH28 0

// KECCAK256 0x20
JUMPDEST
PUSH17 1                                    // Stack: [1, j, offset, size]
ADD                                         // Stack: [i, offset, size]
SWAP2                                       // Stack: [size, offset, i]
SWAP1                                       // Stack: [offset, size, i]
KECCAK256                                   // Stack: [keccak(offset, size), i]
SWAP1                                       // Stack: [i, keccak(offset, size)]

DUP1
CALLDATALOAD
PUSH0
BYTE
PUSH1 5
SHL
JUMP

