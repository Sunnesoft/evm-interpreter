SWAP2                                       // [j, calldata[j:j+0x20], calldata[j:j+2]]
PUSH1 2                                     // [2, j, calldata[j:j+0x20], calldata[j:j+2]]
ADD                                         // [j+2, calldata[j:j+0x20], calldata[j:j+2]]
SWAP1                                       // [calldata[j:j+0x20], j+2, calldata[j:j+2]]
PUSH1 2                                     // [2, calldata[j:j+0x20], j+2, calldata[j:j+2]]
BYTE                                        // [calldata[j+2:j+3], j+2, calldata[j:j+2]]
PUSH1 5                                     // [5, calldata[j+2:j+3], j+2, calldata[j:j+2]]
SHL                                         // [calldata[j+2:j+3] << 5, j+2, calldata[j:j+2]]
JUMP

