MUL                                                     // Stack: [32 or 0, i, a, b, ..., value]
MSIZE                                                   // Stack: [msize, 32 or 0, i, a, b, ..., value]
SUB                                                     // Stack: [msize - (32 or 0), i, a, b, ..., value]
MSTORE // Store the pc in MSIZE or MSIZE - 20           // Stack: [a, b, ..., value], Memory: [msize - (32 or 0):= i]
DUP16                                                   // Stack: [value, a, b ..., value]
PUSH1 32                                                // Restore PC from memory
