DUP1                                                    // Stack: [32, 32, i, a, b ..., value]
MSIZE                                                   // Stack: [msize, 32, 32, i, a, b ..., value]
SUB                                                     // Stack: [msize - 32, 32, i, a, b, ..., value]
MLOAD                                                   // Stack: [memory[msize - 32:msize], 32, i, a, b, ..., value]
